<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:hdr="http://example.com/header/v1"
           xmlns:cmn="http://example.com/common/v1"
           targetNamespace="http://example.com/auth/service/v1"
           xmlns="http://example.com/auth/service/v1"
           elementFormDefault="qualified">

    <xs:import namespace="http://example.com/header/v1"
               schemaLocation="../common/header-types.xsd"/>

    <xs:import namespace="http://example.com/common/v1"
               schemaLocation="../common/common-types.xsd"/>

    <xs:element name="LoginRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="header" type="hdr:RequestHeaderType"/>
                <xs:element name="username" type="xs:string"/>
                <xs:element name="password" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="LoginResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="cmn:StatusType"/>
                <xs:element name="token" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>